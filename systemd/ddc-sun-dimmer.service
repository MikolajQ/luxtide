[Unit]
Description=Display brightness that follows the sun (DDC/CI and backlight)
Documentation=man:ddcutil(1)
PartOf=graphical-session.target
After=graphical-session.target
# The timer and watcher of version 1 must never run next to the daemon.
Conflicts=ddc-sun-dimmer.timer ddc-sun-dimmer-watch.service

[Service]
Type=dbus
BusName=io.github.DdcSunDimmer
ExecStart=@BINDIR@/ddc-sun-dimmer daemon
Restart=on-failure
RestartSec=5s

# ddcutil can log DDC probing straight to syslog, past our stderr. With
# --skip-ddc-checks little is left, but on monitors whose reads are broken
# any probe that remains fails and only floods the journal.
LogFilterPatterns=~read_unsupported_feature
LogFilterPatterns=~Error detecting VCP version

[Install]
WantedBy=graphical-session.target
