[Unit]
Description=React to monitor wake-ups immediately
Documentation=man:ddcutil(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ddc-sun-dimmer-watch
Restart=on-failure
RestartSec=10s
# Reads one sysfs file every couple of seconds; the cost is the sleeping
# process, not the polling.
Nice=10

# ddcutil probes the monitor on every write and logs failures straight to
# syslog, bypassing our stderr capture. On a display whose reads are broken
# those probes always fail, so they are noise with no diagnostic value.
LogFilterPatterns=~read_unsupported_feature
LogFilterPatterns=~Error detecting VCP version

[Install]
WantedBy=graphical-session.target
