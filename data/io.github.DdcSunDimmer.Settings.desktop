[Desktop Entry]
Type=Application
Name=Display Brightness
GenericName=Sun-based brightness
Comment=Screen brightness that follows the sun, for monitors and laptop panels
Exec=@BINDIR@/ddc-sun-dimmer-gui
Icon=display-brightness-symbolic
Terminal=false
Categories=Settings;HardwareSettings;GTK;
Keywords=brightness;monitor;screen;ddc;backlight;sun;dim;night;
StartupNotify=true
