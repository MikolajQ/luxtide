[Desktop Entry]
Type=Application
Name=Luxtide
GenericName=Automatic Brightness
Comment=Screen brightness that follows the sun, for monitors and laptop panels
Exec=@BINDIR@/luxtide-settings
Icon=display-brightness-symbolic
Terminal=false
Categories=Settings;HardwareSettings;GTK;
Keywords=brightness;monitor;screen;ddc;backlight;sun;dim;night;automatic;display;
StartupNotify=true
