#!/usr/bin/env bash
# Pilnuje stanu podświetlenia panelu i reaguje na wybudzenie w sekundy.
#
# Timer co minutę prowadzi rampę dobrze, ale do wykrycia wybudzenia jest za
# wolny: zanim tyknie, ekran zdąży świecić pełną mocą ponad minutę. Odczyt
# sysfs jest mikrosekundowy, więc pytać można często — kosztem jest sam proces.

set -u

# Zewnętrzny /bin/sleep kosztuje forka przy każdej iteracji, czyli kilkadziesiąt
# tysięcy razy na dobę — mierzalnie więcej niż sama obserwacja. Ładowalny
# builtin usuwa ten koszt; gdzie go nie ma, pętla działa tak samo, tylko drożej.
for _dir in /usr/lib/bash /usr/lib/*/bash /usr/local/lib/bash; do
    if [[ -r $_dir/sleep ]] && enable -f "$_dir/sleep" sleep 2>/dev/null; then
        break
    fi
done
unset _dir

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ddc-sun-dimmer"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ddc-sun-dimmer/config.ini"
CORE="$(dirname "$(readlink -f "$0")")/ddc-sun-dimmer"

POLL_DIM=2        # gdy przygaszamy — wtedy liczy się czas reakcji
POLL_IDLE=20      # przy poziomie dziennym monitor sam wraca na to, czego chcemy

# Plik dpms podłączonego złącza. Szukamy raz, ale gdyby kabel przepięto,
# pętla główna sięgnie po niego ponownie.
find_dpms() {
    local status dpms
    for status in /sys/class/drm/card*-*/status; do
        [[ -r $status ]] || continue
        [[ $(<"$status") == connected ]] || continue
        dpms="${status%/status}/dpms"
        [[ -r $dpms ]] && { printf '%s' "$dpms"; return 0; }
    done
    return 1
}

# Poziom dzienny z konfiguracji; służy wyłącznie do decyzji o czujności.
day_level() {
    awk -F'=' '
        /^[[:space:]]*\[/ { section = $0 }
        section ~ /levels/ && /^[[:space:]]*day[[:space:]]*=/ {
            gsub(/[^0-9]/, "", $2); print $2; exit
        }' "$CONFIG" 2>/dev/null
}

DAY=$(day_level); DAY=${DAY:-100}

DPMS=$(find_dpms) || { echo "nie znaleziono podłączonego monitora" >&2; exit 1; }
prev=$(<"$DPMS")
echo "obserwuję ${DPMS#/sys/class/drm/} (stan: $prev, poziom dzienny ${DAY}%)"

dimming=""
while :; do
    # Docelowy poziom przetrwa uśpienie, w przeciwieństwie do pliku "level".
    if [[ -r $STATE_DIR/target ]]; then target=$(<"$STATE_DIR/target")
    else target=$DAY; fi
    if [[ $target =~ ^[0-9]+$ ]] && (( target < DAY )); then
        interval=$POLL_DIM; now_dimming=tak
    else
        interval=$POLL_IDLE; now_dimming=nie
    fi
    if [[ $now_dimming != "$dimming" ]]; then
        echo "czujność: co ${interval} s (przygaszamy: ${now_dimming})"
        dimming=$now_dimming
    fi

    sleep "$interval"

    if [[ ! -r $DPMS ]]; then
        DPMS=$(find_dpms) || { sleep 30; continue; }
        prev=$(<"$DPMS")
        continue
    fi
    cur=$(<"$DPMS")

    if [[ $cur == On && $prev != On ]]; then
        echo "wykryto wybudzenie, narzucam poziom"
        "$CORE" --wake --verbose
    elif [[ $cur != On && $prev == On ]]; then
        # Stan przestał opisywać sprzęt: po wybudzeniu firmware wstawi własną
        # jasność, więc zapamiętany poziom jest już nieprawdziwy.
        rm -f "$STATE_DIR/level"
        printf 'asleep' > "$STATE_DIR/wake-until"
        echo "panel wygaszony"
    fi
    prev=$cur
done
