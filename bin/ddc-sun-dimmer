#!/usr/bin/env python3
"""Ustawia jasność monitora przez DDC/CI zależnie od pozycji słońca.

Tryb płynny (domyślny) przesuwa jasność liniowo w oknie wokół wschodu
i zachodu, tak że dokładnie w ich momencie wypada poziom "twilight":

    noc  50% ──╱ wschód ╱── 100% dzień 100% ──╲ zachód ╲── 50%  noc
              (−1h..+1h)                      (−1h..+1h)

Tryb skokowy przełącza wprost między trzema poziomami.

Konfiguracja: ~/.config/ddc-sun-dimmer/config.ini (patrz config.example).
"""

import argparse
import configparser
import datetime as dt
import math
import os
import pathlib
import subprocess
import sys
import time
import zoneinfo

APP = "ddc-sun-dimmer"

CONFIG_PATH = pathlib.Path(
    os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")
) / APP / "config.ini"

STATE_DIR = pathlib.Path(
    os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")
) / APP

DDCUTIL = "/usr/bin/ddcutil"
BACKOFF_CAP = dt.timedelta(minutes=15)

DEFAULTS = {
    "location": {"latitude": "", "longitude": "", "timezone": ""},
    "levels": {"day": "100", "twilight": "75", "night": "50"},
    "schedule": {"smooth": "yes", "margin_minutes": "60",
                 "curve": "perceptual",
                 "wake_window_seconds": "90", "refresh_minutes": "5"},
    "ddc": {"bus": "", "sleep_multiplier": "2", "retries": "5",
            "repeats": "3", "settle": "0.2"},
    # Domyślnie wyłączone: nadpisywanie cudzych ustawień koloru jest
    # zaskakujące, a rozszerzenia pokroju Night Light Scheduler robią to
    # lepiej. Włączać świadomie.
    "night_light": {"sync": "no"},
}


# --- konfiguracja ---------------------------------------------------------


def system_timezone():
    """Nazwa strefy z /etc/localtime, np. 'Europe/Warsaw'."""
    try:
        target = pathlib.Path("/etc/localtime").resolve()
        parts = target.parts
        if "zoneinfo" in parts:
            index = len(parts) - 1 - parts[::-1].index("zoneinfo")
            return "/".join(parts[index + 1:])
    except OSError:
        pass
    return "UTC"


class Config:
    """Ustawienia z pliku INI, z wartościami domyślnymi dla brakujących pól."""

    def __init__(self, path=CONFIG_PATH):
        parser = configparser.ConfigParser()
        parser.read_dict(DEFAULTS)
        self.path = path
        self.loaded = path.exists()
        if self.loaded:
            parser.read(path, encoding="utf-8")

        if not parser.get("location", "latitude").strip():
            raise SystemExit(
                f"brak współrzędnych w {path}\n"
                f"utwórz plik na wzór config.example albo uruchom: dim-gui"
            )

        self.latitude = parser.getfloat("location", "latitude")
        self.longitude = parser.getfloat("location", "longitude")
        zone = parser.get("location", "timezone").strip() or system_timezone()
        self.tz = zoneinfo.ZoneInfo(zone)
        self.zone_name = zone

        # Dolna granica to 1, nie 0: zero potrafi wygasić podświetlenie
        # całkowicie i zostawić czarny ekran do odkręcenia wyłącznie z OSD.
        clamp = lambda value: max(1, min(100, value))
        self.day = clamp(parser.getint("levels", "day"))
        self.twilight = clamp(parser.getint("levels", "twilight"))
        self.night = clamp(parser.getint("levels", "night"))

        self.smooth = parser.getboolean("schedule", "smooth")
        # "perceptual" interpoluje geometrycznie. Wrażenie jasności rośnie mniej
        # więcej z pierwiastkiem sześciennym luminancji, więc interpolacja
        # liniowa w jednostkach DDC stoi dla oka w miejscu przez większość rampy,
        # a potem gaśnie skokiem. Geometryczna rozkłada zmianę równomiernie.
        self.curve = parser.get("schedule", "curve").strip().lower()
        self.margin = dt.timedelta(
            minutes=parser.getint("schedule", "margin_minutes"))
        self.wake_window = dt.timedelta(
            seconds=parser.getint("schedule", "wake_window_seconds"))
        self.refresh = dt.timedelta(
            minutes=parser.getint("schedule", "refresh_minutes"))

        self.bus = parser.get("ddc", "bus").strip() or None
        self.sleep_multiplier = parser.get("ddc", "sleep_multiplier").strip()
        self.retries = parser.getint("ddc", "retries")
        self.repeats = parser.getint("ddc", "repeats")
        self.settle = parser.getfloat("ddc", "settle")

        self.sync_night_light = parser.getboolean("night_light", "sync")


# --- pozycja słońca (NOAA, uproszczony) -----------------------------------


def sun_events(date, cfg):
    """(wschód, zachód) jako aware datetime w strefie z konfiguracji."""
    n = (date - dt.date(2000, 1, 1)).days + 0.0009 - cfg.longitude / 360.0
    j = n + 2451545.0
    m = math.radians((357.5291 + 0.98560028 * (j - 2451545.0)) % 360)
    c = 1.9148 * math.sin(m) + 0.0200 * math.sin(2 * m) + 0.0003 * math.sin(3 * m)
    lam = math.radians((math.degrees(m) + c + 180 + 102.9372) % 360)
    j_transit = j + 0.0053 * math.sin(m) - 0.0069 * math.sin(2 * lam)
    decl = math.asin(math.sin(lam) * math.sin(math.radians(23.4397)))

    lat = math.radians(cfg.latitude)
    cos_w = (math.sin(math.radians(-0.833)) - math.sin(lat) * math.sin(decl)) / (
        math.cos(lat) * math.cos(decl)
    )
    # Poza kołem podbiegunowym słońce może nie wzejść ani nie zajść — wtedy
    # acos dostałby wartość spoza [-1, 1], więc przycinamy i dzień wychodzi
    # zerowy albo pełny.
    w = math.degrees(math.acos(max(-1.0, min(1.0, cos_w))))

    def to_local(julian):
        ts = (julian - 2440587.5) * 86400
        return dt.datetime.fromtimestamp(ts, dt.timezone.utc).astimezone(cfg.tz)

    return to_local(j_transit - w / 360.0), to_local(j_transit + w / 360.0)


def anchors(now, cfg):
    """Punkty (moment, poziom) dla wczoraj/dziś/jutra, posortowane rosnąco."""
    points = []
    for offset in (-1, 0, 1):
        rise, set_ = sun_events(now.date() + dt.timedelta(days=offset), cfg)
        if cfg.smooth:
            points += [
                (rise - cfg.margin, cfg.night),
                (rise, cfg.twilight),
                (rise + cfg.margin, cfg.day),
                (set_ - cfg.margin, cfg.day),
                (set_, cfg.twilight),
                (set_ + cfg.margin, cfg.night),
            ]
        else:
            points += [
                (rise - cfg.margin, cfg.twilight),
                (rise + cfg.margin, cfg.day),
                (set_ - cfg.margin, cfg.twilight),
                (set_ + cfg.margin, cfg.night),
            ]
    return sorted(points)


def level_at(moment, cfg, points=None):
    """Docelowa jasność w danej chwili, zaokrąglona do pełnych procent."""
    points = points if points is not None else anchors(moment, cfg)

    previous = None
    for when, level in points:
        if when > moment:
            if previous is None:
                return level
            prev_when, prev_level = previous
            if not cfg.smooth:
                return prev_level
            span = (when - prev_when).total_seconds()
            progress = (moment - prev_when).total_seconds() / span
            if cfg.curve == "perceptual":
                # Poziomy są zawsze >= 1, więc iloraz jest bezpieczny.
                return max(1, round(prev_level * (level / prev_level) ** progress))
            return round(prev_level + (level - prev_level) * progress)
        previous = (when, level)
    return previous[1] if previous else cfg.night


def next_change(now, cfg, horizon=dt.timedelta(hours=26)):
    """Kiedy zaokrąglona jasność zmieni się po raz pierwszy i na jaką wartość."""
    points = anchors(now, cfg)
    current = level_at(now, cfg, points)
    moment = now.replace(second=0, microsecond=0)
    while moment - now < horizon:
        moment += dt.timedelta(minutes=1)
        level = level_at(moment, cfg, points)
        if level != current:
            return moment, level
    return None, None


# --- sterowanie monitorem -------------------------------------------------


def detect_bus(cfg):
    """Numer magistrali I2C monitora; wynik cache'owany, bo detekcja trwa."""
    if cfg.bus:
        return cfg.bus

    cache = STATE_DIR / "bus"
    if cache.exists():
        return cache.read_text().strip()

    out = subprocess.run(
        [DDCUTIL, "detect", "--brief"], capture_output=True, text=True, timeout=60
    ).stdout
    for line in out.splitlines():
        if "/dev/i2c-" in line:
            bus = line.split("/dev/i2c-")[1].split()[0]
            cache.write_text(bus)
            return bus
    return None


def display_awake():
    """Czy panel jest wybudzony. Śpiący monitor nie odpowiada na DDC.

    Bez tego sprawdzenia skrypt tłukłby w martwą magistralę przez cały czas
    wygaszenia ekranu (zmierzone: 13 minut po 15 transakcji na minutę).
    """
    for path in pathlib.Path("/sys/class/drm").glob("card*-*/dpms"):
        status = path.with_name("status")
        if status.exists() and status.read_text().strip() == "connected":
            return path.read_text().strip() == "On"
    return True   # nie wiemy — lepiej spróbować niż nie zrobić nic


def write_once(bus, level, cfg):
    """Jedna transakcja, z ponowieniami błędów widocznych dla sterownika."""
    for _ in range(cfg.retries):
        result = subprocess.run(
            [DDCUTIL, "--bus", bus, "--noverify",
             "--sleep-multiplier", cfg.sleep_multiplier,
             "setvcp", "10", str(level)],
            capture_output=True, text=True, timeout=60,
        )
        if result.returncode == 0 and "failed" not in result.stderr.lower():
            return True
    return False


def set_brightness(level, cfg, verbose=False):
    """Zapisuje jasność. True gdy choć jedna transakcja przeszła.

    Zapis DDC/CI nie jest potwierdzany, a odczyt bywa niewiarygodny, więc
    weryfikacja odpada — wysyłamy wartość kilka razy, bo tylko redundancja
    chroni przed cichym zgubieniem ramki.
    """
    bus = detect_bus(cfg)
    if bus is None:
        print("nie znaleziono monitora DDC", file=sys.stderr)
        return False

    delivered = 0
    for _ in range(cfg.repeats):
        if write_once(bus, level, cfg):
            delivered += 1
        time.sleep(cfg.settle)

    if delivered:
        if verbose:
            print(f"ustawiono {level}% ({delivered}/{cfg.repeats} zapisów przeszło)")
        return True

    # Magistrala mogła zmienić numer (przepięcie kabla) — wymuś ponowną detekcję.
    (STATE_DIR / "bus").unlink(missing_ok=True)
    return False


# --- GNOME Night Light ----------------------------------------------------


NIGHT_LIGHT_SCHEMA = "org.gnome.settings-daemon.plugins.color"


def gsetting(key):
    """Bieżąca wartość klucza albo None, gdy odczyt się nie powiedzie."""
    result = subprocess.run(["gsettings", "get", NIGHT_LIGHT_SCHEMA, key],
                            capture_output=True, text=True, timeout=30)
    return result.stdout.strip() if result.returncode == 0 else None


def sync_night_light(now, cfg):
    """Dopasowuje okno Night Light do zmierzchu i świtu.

    Ustępuje użytkownikowi: nie włącza Night Light, gdy ten go wyłączył, i nie
    rusza harmonogramu, gdy wybrał tryb automatyczny GNOME (wtedy GNOME liczy
    zachód sam i nasza korekta jest zbędna). Wcześniejsza wersja narzucała oba
    przełączniki przy każdym przebiegu, więc cofała ręczne zmiany w ciągu minuty.
    """
    if gsetting("night-light-enabled") != "true":
        return
    if gsetting("night-light-schedule-automatic") == "true":
        return

    rise, set_ = sun_events(now.date(), cfg)
    as_hours = lambda t: t.hour + t.minute / 60.0
    wanted = {
        "night-light-schedule-from": as_hours(set_ - cfg.margin),
        "night-light-schedule-to": as_hours(rise + cfg.margin),
    }

    # Zapis tylko przy realnej różnicy: okno zmienia się raz na dobę, więc bez
    # tego warunku schodziłoby kilka tysięcy jałowych wywołań gsettings dziennie.
    for key, value in wanted.items():
        current = gsetting(key)
        try:
            if current is not None and abs(float(current) - value) < 0.01:
                continue
        except ValueError:
            pass
        subprocess.run(["gsettings", "set", NIGHT_LIGHT_SCHEMA, key, f"{value:.2f}"],
                       capture_output=True, timeout=30)


# --- wycofywanie po awariach ----------------------------------------------


def read_backoff():
    """(liczba porażek z rzędu, moment kolejnej dozwolonej próby)."""
    path = STATE_DIR / "backoff"
    if not path.exists():
        return 0, None
    try:
        fails, when = path.read_text().split(maxsplit=1)
        return int(fails), dt.datetime.fromisoformat(when.strip())
    except ValueError:
        return 0, None


def bump_backoff(fails, now):
    """Podwaja odstęp po każdej porażce, do BACKOFF_CAP."""
    fails += 1
    delay = min(dt.timedelta(minutes=2 ** (fails - 1)), BACKOFF_CAP)
    (STATE_DIR / "backoff").write_text(f"{fails} {(now + delay).isoformat()}")
    return delay


# --- główna logika --------------------------------------------------------


def show_status(now, cfg):
    rise, set_ = sun_events(now.date(), cfg)
    next_at, next_level = next_change(now, cfg)
    state = STATE_DIR / "level"

    print(f"{cfg.latitude:.4f}, {cfg.longitude:.4f} ({cfg.zone_name})   tryb: "
          f"{'płynny' if cfg.smooth else 'skokowy'}"
          f"{' / percepcyjny' if cfg.smooth and cfg.curve == 'perceptual' else ''}")
    print(f"  {now:%Y-%m-%d %H:%M}")
    print(f"  wschód {rise:%H:%M}   zachód {set_:%H:%M}")
    print(f"  teraz:    {level_at(now, cfg)}%")
    if next_at:
        print(f"  następna: {next_level}% o {next_at:%H:%M} ({next_at:%d.%m})")
    print(f"  zapisane: {state.read_text().strip() if state.exists() else '—'}%")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--force", action="store_true",
                        help="zapisz nawet gdy poziom się nie zmienił")
    parser.add_argument("--status", action="store_true",
                        help="pokaż harmonogram i wyjdź, niczego nie zmieniając")
    parser.add_argument("--verbose", action="store_true")
    args = parser.parse_args()

    cfg = Config()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    now = dt.datetime.now(cfg.tz)

    if args.status:
        show_status(now, cfg)
        return 0

    level = level_at(now, cfg)
    if cfg.sync_night_light:
        sync_night_light(now, cfg)

    state = STATE_DIR / "level"
    wake_flag = STATE_DIR / "wake-until"

    # Śpiący panel nie odpowiada na DDC, a po wybudzeniu wraca na własną
    # jasność — więc kasujemy zapamiętany stan, bo przestał opisywać sprzęt.
    if not display_awake() and not args.force:
        state.unlink(missing_ok=True)
        wake_flag.write_text("asleep")
        if args.verbose:
            print(f"monitor wygaszony, odkładam {level}%")
        return 0

    # Przejście uśpiony -> wybudzony otwiera okno dosypywania. Firmware tego
    # monitora przywraca własną jasność dopiero kilkanaście sekund po
    # wybudzeniu, więc pojedynczy zapis w chwili przebudzenia zostaje
    # nadpisany, a "bez zmian" nigdy go nie poprawia.
    if wake_flag.exists() and wake_flag.read_text().strip() == "asleep":
        wake_flag.write_text((now + cfg.wake_window).isoformat())
        if args.verbose:
            print(f"przebudzenie, dosypuję przez {cfg.wake_window}")

    settling = False
    if wake_flag.exists():
        try:
            settling = now < dt.datetime.fromisoformat(wake_flag.read_text().strip())
        except ValueError:
            settling = False

    previous = state.read_text().strip() if state.exists() else None
    unchanged = previous == str(level)

    # Poza oknem dosypywania odświeżamy cyklicznie, ale tylko gdy faktycznie
    # przygaszamy: w dzień monitor po zgubieniu ustawienia wraca na 100%,
    # czyli dokładnie na to, co i tak chcemy — zapis byłby pustym kosztem.
    stale = False
    if unchanged and not settling and level < cfg.day and state.exists():
        age = now.timestamp() - state.stat().st_mtime
        stale = age >= cfg.refresh.total_seconds()

    if unchanged and not (args.force or settling or stale):
        if args.verbose:
            print(f"bez zmian ({level}%)")
        return 0

    fails, retry_after = read_backoff()
    if retry_after and now < retry_after and not args.force:
        if args.verbose:
            print(f"wycofanie po {fails} porażkach, następna próba "
                  f"{retry_after:%H:%M}")
        return 0

    if set_brightness(level, cfg, args.verbose):
        state.write_text(str(level))   # zapis odświeża też mtime dla cyklu
        (STATE_DIR / "backoff").unlink(missing_ok=True)
        if args.verbose:
            reason = "dosypywanie" if settling else "odświeżenie cykliczne"
            print(f"odświeżono {level}% ({reason})" if unchanged
                  else f"jasność {previous or '—'}% -> {level}%")
        return 0

    # Monitor odłączony albo wyłączony fizycznie (DPMS tego nie pokaże).
    delay = bump_backoff(fails, now)
    print(f"nie udało się ustawić {level}%, kolejna próba za {delay}",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
